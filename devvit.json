{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "redlex-mod",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      },
      {
        "label": "⚖️ RedLex — Add Strike",
        "description": "Log a guideline strike against this user.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-strike-comment"
      },
      {
        "label": "⚖️ RedLex — Add Strike",
        "description": "Log a guideline strike against this user.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-strike-post"
      },
      {
        "label": "🔍 RedLex — View Strikes",
        "description": "View strike history for a user.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-strikes"
}
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit",
    "addStrikeComment": "/internal/form/add-strike-submit",
    "addStrikePost": "/internal/form/add-strike-submit",
    "viewStrikes": "/internal/form/view-strikes-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModAction": "/internal/triggers/on-mod-action"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "dev": {
    "subreddit": "redlex_mod_dev"
  }
  
}
