{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "redlex-mod",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },

  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
        
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      },
      {
        "label": "⚖️ RedLex — Add Strike",
        "description": "Log a guideline strike against this user.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-strike-comment"
      },
      {
        "label": "⚖️ RedLex — Add Strike",
        "description": "Log a guideline strike against this user.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-strike-post"
      },
      {
        "label": "🔍 RedLex — View Strikes",
        "description": "View strike history for a user.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-strikes"
      },
      {
        "label": "🔍 RedLex — View Strikes",
        "description": "Look up strike history for any user.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-strikes"
      },
      {
  "label": "⚖️ Create RedLex Dashboard",
  "description": "Create a RedLex strike viewer post in this subreddit.",
  "location": "subreddit",
  "forUserType": "moderator",
  "endpoint": "/internal/menu/create-redlex-post"
},
      {
        "label": "📋 Add Shift Note",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-shift-note"
      },
      {
        "label": "📋 View Shift Notes",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-shift-notes"
      },
      {
        "label": "✅ Resolve Shift Note",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/resolve-shift-note"
      },
      {
        "label": "📋 Create Transparency Log Post",
        "description": "Create a public mod action log post in this subreddit.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-log-post"
      },
      {
        "label": "🎉 Configure Milestones",
        "description": "Set up automatic celebration posts for subscriber milestones.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/configure-milestones"
      },
      {
        "label": "🎉 View Celebrated Milestones",
        "description": "See which milestones have been celebrated.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-milestones"
      },
      {
        "label": "📰 Setup Weekly Digest",
        "description": "Configure the AI-powered weekly community digest.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/setup-digest"
      },
      {
        "label": "📰 Generate Digest Now",
        "description": "Generate and post this week's community digest now.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/generate-digest-now"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit",
    "addStrikeComment": "/internal/form/add-strike-submit",
    "addStrikePost": "/internal/form/add-strike-submit",
    "viewStrikes": "/internal/form/view-strikes-submit",
    "createRedlexPost": "/internal/form/create-redlex-post-submit",
    "viewStrikesResult": "/internal/form/view-strikes-result-noop",
    "addShiftNote": "/internal/form/add-shift-note-submit",
    "viewShiftNotes": "/internal/form/view-shift-notes-submit",
    "viewShiftNotesResult": "/internal/form/view-shift-notes-result-noop",
    "resolveShiftNote": "/internal/form/resolve-shift-note-submit",
    "createLogPost": "/internal/form/create-log-post-submit",
    "configureMilestones": "/internal/form/configure-milestones-submit",
    "viewMilestones": "/internal/form/view-milestones-submit",
    "viewMilestonesResult": "/internal/form/view-milestones-result-noop",
    "setupDigest": "/internal/form/setup-digest-submit",
    "generateDigestNow": "/internal/form/generate-digest-now-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModAction": "/internal/triggers/on-mod-action",
    "onPostSubmit": "/internal/triggers/on-post-submit"
  },
  "scheduler": {
    "tasks": {
      "weekly-digest": {
        "endpoint": "/internal/scheduler/weekly-digest",
        "cron": "0 9 * * 1"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "dev": {
    "subreddit": "redlex_mod_dev"
  }
  
}
